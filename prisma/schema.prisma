// Elevate workforce-readiness platform database schema
// Covers: users, career pathways, scenarios, skills, progress, portfolio, feedback

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String                   @id @default(cuid())
  email         String                   @unique
  passwordHash  String
  displayName   String?
  bio           String?
  avatarUrl     String?
  ageGroup      String?
  location      String?
  language      String                   @default("en")
  interests     String[]
  goals         String[]
  accessibility AccessibilityPreferences? @relation("UserAccessibility")
  accessibilityId String?                  @unique
  skills        Skill[]                  @relation("userSkills")
  careerPathways CareerPathway[]
  scenarioSessions ScenarioSession[]
  portfolios    Portfolio[]
  recommendations Recommendation[]
  progress      ProgressEntry[]
  integrations  Integration[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([email])
}

model AccessibilityPreferences {
  id              String   @id @default(cuid())
  userId          String   @unique
  screenReader    Boolean  @default(false)
  keyboardNavigation Boolean @default(true)
  fontSize        String   @default("medium")
  highContrast    Boolean  @default(false)
  captions        Boolean  @default(false)
  transcripts      Boolean  @default(false)
  reducedMotion   Boolean  @default(false)
  simpleLanguage  Boolean  @default(false)
  user            User     @relation("UserAccessibility", fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id          String           @id @default(cuid())
  name        String           @unique
  category    String
  description String?
  users       User[]           @relation("userSkills")
  scenarios   ScenarioSkill[]
  progress    ProgressEntry[]

  @@index([category])
}

model CareerPathway {
  id          String      @id @default(cuid())
  name        String      @unique
  industry    String
  description String?
  level       String      @default("entry")
  skills      String[]
  scenarios   Scenario[]
  users       User[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([industry])
}

model Scenario {
  id          String           @id @default(cuid())
  title       String
  description String
  industry    String
  difficulty  String           @default("beginner")
  category    String
  prompt      String
  options     Json
  correctAnswer String?
  tips        String[]
  skills      ScenarioSkill[]
  pathways    CareerPathway[]
  sessions    ScenarioSession[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([industry])
  @@index([category])
  @@index([difficulty])
}

model ScenarioSkill {
  scenarioId String
  skillId    String
  weight     Int      @default(1)
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  skill      Skill    @relation(fields: [skillId], references: [id])
  @@id([scenarioId, skillId])
}

model ScenarioSession {
  id            String    @id @default(cuid())
  userId        String
  scenarioId    String
  userChoice   String?
  correct      Boolean?
  timeTakenSec  Int?
  aiFeedback    String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario      Scenario  @relation(fields: [scenarioId], references: [id])
  feedback      Feedback?

  @@index([userId])
  @@index([scenarioId])
}

model Feedback {
  id            String           @id @default(cuid())
  sessionId     String           @unique
  whatWentWell  String
  whatToImprove String
  nextSteps     String
  retryAdvice   String?
  score         Float?
  createdAt     DateTime         @default(now())
  session       ScenarioSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ProgressEntry {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  score     Float
  date      DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill    @relation(fields: [skillId], references: [id])

  @@index([userId, skillId])
  @@index([date])
}

model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String
  evidenceUrl String?
  skillIds    String[]
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic])
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  type        String
  targetId    String
  reason      String
  priority    Int      @default(1)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed])
}

model Integration {
  id            String   @id @default(cuid())
  userId        String
  provider      String
  externalId    String?
  tokenEncrypted String?
  metadata      Json?
  syncedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}